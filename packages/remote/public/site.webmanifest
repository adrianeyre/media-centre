{
  "name": "Media Centre",
  "short_name": "Media Centre",
  "description": "One remote for your whole home: TVs, air conditioners, lights, heating, Echo and Ring, room by room, and your films and music on any TV.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en-GB",
  "dir": "ltr",
  "background_color": "#080D19",
  "theme_color": "#080D19",
  "categories": ["utilities", "entertainment", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/mask-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "monochrome" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/wide-tv.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The TV tab: a remote control for each TV, with what's on, its apps and your own media"
    },
    {
      "src": "/screenshots/wide-rooms.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The Rooms tab: everything in each room, on your own floor plan"
    },
    {
      "src": "/screenshots/narrow-tv.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The TV tab on a phone"
    },
    {
      "src": "/screenshots/narrow-lights.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The Lights tab on a phone"
    }
  ]
}
